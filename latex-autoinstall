#!/usr/bin/env bash
# latex-autoinstall — 编译时自动下载缺失的 TeX Live 宏包
#
# 作为 xelatex / pdflatex / lualatex 的包装器使用(见 install.sh)。
# 编译失败且日志中出现 "File `xxx.sty' not found" 时,用 tlmgr 用户模式
# 把对应的宏包装进 ~/texmf,然后自动重新编译。
#
# 可调环境变量:
#   TEX_AUTOINSTALL_REPO    指定仓库(覆盖自动检测)
#   TEX_AUTOINSTALL_ROUNDS  最多尝试轮数(默认 8)
#   TEX_AUTOINSTALL_TIMEOUT 单次安装超时秒数(默认 180)
#   TEX_AUTOINSTALL_OFF=1   完全禁用自动安装,退化为直接调用引擎

set -uo pipefail

MAX_ROUNDS="${TEX_AUTOINSTALL_ROUNDS:-8}"
INSTALL_TIMEOUT="${TEX_AUTOINSTALL_TIMEOUT:-180}"

# ---------------------------------------------------------------- 引擎识别
self=$(basename "$0")
case "$self" in
    xelatex|pdflatex|lualatex|latex) engine="$self" ;;
    *)
        if [ $# -eq 0 ]; then
            echo "用法: $self <xelatex|pdflatex|lualatex> [引擎参数...]" >&2
            exit 2
        fi
        engine="$1"; shift
        ;;
esac

real="/usr/bin/$engine"
if [ ! -x "$real" ]; then
    echo "latex-autoinstall: 找不到 $real" >&2
    exit 127
fi

if [ "${TEX_AUTOINSTALL_OFF:-0}" = "1" ] || ! command -v tlmgr >/dev/null 2>&1; then
    exec "$real" "$@"
fi

# 首次使用时初始化 tlmgr 用户树
if [ ! -d "$HOME/texmf/tlpkg" ]; then
    tlmgr init-usertree >/dev/null 2>&1 || true
fi

# ---------------------------------------------------------------- 仓库选择
# TeX Live 每年发布一次;冻结版的包只存在于 historic 目录,
# 当年的 tlnet 则可以用常规镜像。
tl_year() {
    tlmgr --version 2>/dev/null \
        | sed -n 's/.*version \([0-9]\{4\}\).*/\1/p' | head -1
}

repos() {
    if [ -n "${TEX_AUTOINSTALL_REPO:-}" ]; then
        printf '%s\n' "$TEX_AUTOINSTALL_REPO"
        return
    fi
    local y
    y=$(tl_year)
    [ -n "$y" ] && printf 'https://ftp.math.utah.edu/pub/tex/historic/systems/texlive/%s/tlnet-final\n' "$y"
    printf 'https://mirror.ctan.org/systems/texlive/tlnet\n'
}

out=$(mktemp)
trap 'rm -f "$out" "$out.install"' EXIT

# ---------------------------------------------------------------- 安装单个包
# $1 = 包名,$2 = 用来验证的文件名
install_pkg() {
    local pkg="$1" file="$2" repo
    while IFS= read -r repo; do
        [ -z "$repo" ] && continue
        timeout "$INSTALL_TIMEOUT" tlmgr --usermode -repository "$repo" \
            install "$pkg" </dev/null >"$out.install" 2>&1
        # tlmgr 的退出码不可靠(会报告失败却返回 0),以 kpsewhich 为准
        if kpsewhich "$file" >/dev/null 2>&1; then
            return 0
        fi
        # 仓库里根本没有这个包名,换仓库也没有意义
        if grep -qiE "not present in repository|no such package|unknown package" "$out.install"; then
            return 1
        fi
        mktexlsr "$HOME/texmf" >/dev/null 2>&1 || true
        kpsewhich "$file" >/dev/null 2>&1 && return 0
    done < <(repos)
    return 1
}

# 通过文件名反查所属包(网络较慢,仅在包名猜测失败时使用)
owner_of() {
    local file="$1" repo
    while IFS= read -r repo; do
        [ -z "$repo" ] && continue
        timeout 180 tlmgr --usermode -repository "$repo" \
            search --global --file "$file" </dev/null 2>/dev/null \
            | awk 'NR==1 {print $1}'
    done < <(repos)
}

# ---------------------------------------------------------------- 主循环
for ((round = 1; round <= MAX_ROUNDS; round++)); do
    "$real" "$@" >"$out" 2>&1
    status=$?
    cat "$out"
    [ "$status" -eq 0 ] && exit 0

    mapfile -t missing < <(sed -n "s/.*File .\([^']*\)' not found.*/\1/p" "$out" | sort -u)
    [ "${#missing[@]}" -eq 0 ] && exit "$status"

    installed=0
    for f in "${missing[@]}"; do
        pkg="${f%.*}"
        echo "latex-autoinstall: 缺少 $f,正在安装宏包 '$pkg' ..." >&2
        if install_pkg "$pkg" "$f"; then
            installed=1
            continue
        fi
        echo "latex-autoinstall: '$pkg' 不是包名或安装失败,查询文件归属 ..." >&2
        tail -3 "$out.install" >&2
        owner=$(owner_of "$f")
        if [ -n "${owner:-}" ] && install_pkg "$owner" "$f"; then
            installed=1
        else
            echo "latex-autoinstall: 无法自动安装 $f(可试 apt-file search $f)" >&2
        fi
    done

    [ "$installed" -eq 0 ] && exit "$status"
    echo "latex-autoinstall: 宏包就绪,重新编译(第 $((round + 1)) 轮)..." >&2
done

"$real" "$@" >"$out" 2>&1
status=$?
cat "$out"
exit "$status"
